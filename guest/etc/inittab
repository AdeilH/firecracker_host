# /etc/inittab for microvms guests (serial console only)
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# Firecracker graceful shutdown: the daemon sends CtrlAltDel, which the kernel
# turns into SIGINT to init; power off instead of the default reboot.
::ctrlaltdel:/sbin/poweroff -f

# Serial getty for debugging from the host (fc.log / firecracker console)
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100

::shutdown:/sbin/openrc shutdown
